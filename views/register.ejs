<%- include('./include/_home_header') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-5">
          <div class="text-center">
            <i class="fa-solid fa-user-plus fa-4x text-primary mb-4"></i>
            <h2 class="fw-bold mb-3">회원가입</h2>
            <p class="text-muted mb-4">새로운 계정을 만들어 보세요.</p>
          </div>

          <form action="/register" method="POST">
            <div class="form-floating mb-3">
              <input type="text" class="form-control" name="username" id="username" placeholder="ID" required>
              <label for="username">사용자 아이디</label>
            </div>
            <div class="form-floating mb-3">
              <input type="password" class="form-control" name="password" id="password" placeholder="Password" required>
              <label for="password">비밀번호</label>
            </div>
            <div class="form-floating mb-4">
              <input type="password" class="form-control" name="password2" id="password2" placeholder="Confirm Password" required>
              <label for="password2">비밀번호 확인</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">가입하기</button>
          </form>

          <div class="mt-4 text-center">
            <span class="text-muted small">이미 계정이 있으신가요?</span>
            <a href="/" class="text-primary small fw-bold ms-1">로그인</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('./include/_footer') %>
