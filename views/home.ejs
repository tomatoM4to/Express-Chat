<%- include('./include/_home_header') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-5 text-center">
          <i class="fa-solid fa-circle-user fa-4x text-primary mb-4"></i>
          <h2 class="fw-bold mb-3">로그인</h2>
          <p class="text-muted mb-4">채팅 서비스를 이용하려면 로그인해 주세요.</p>

          <form action="/" method="POST">
            <div class="form-floating mb-3">
              <input type="text" class="form-control" name="username" id="username" placeholder="ID" required>
              <label for="username">사용자 아이디</label>
            </div>
            <div class="form-floating mb-4">
              <input type="password" class="form-control" name="password" id="password" placeholder="Password" required>
              <label for="password">비밀번호</label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold">로그인</button>
          </form>

          <div class="mt-4 text-center">
            <span class="text-muted small">계정이 없으신가요?</span>
            <a href="/register" class="text-primary small fw-bold ms-1">회원가입</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('./include/_footer') %>
