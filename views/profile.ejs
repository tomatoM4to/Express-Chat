<%- include('./include/_header') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
          <h2 class="fw-bold mb-4 pb-3 border-bottom">내 프로필 설정</h2>
          
          <!-- Nav Tabs -->
          <ul class="nav nav-pills mb-4 bg-light p-2 rounded-3" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active fw-bold" id="chat-history-tab" data-bs-toggle="pill" data-bs-target="#chat-history" type="button" role="tab">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>채팅 기록
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link fw-bold" id="account-settings-tab" data-bs-toggle="pill" data-bs-target="#account-settings" type="button" role="tab">
                <i class="fa-solid fa-user-gear me-2"></i>계정 설정
              </button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="profileTabsContent">
            
            <!-- Chat History Tab -->
            <div class="tab-pane fade show active" id="chat-history" role="tabpanel">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead class="bg-light">
                    <tr>
                      <th>채팅방</th>
                      <th>내용</th>
                      <th>날짜</th>
                      <th class="text-end">동작</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (messages.length === 0) { %>
                      <tr><td colspan="4" class="text-center py-5 text-muted">기록이 없습니다.</td></tr>
                    <% } %>
                    <% messages.forEach(msg => { %>
                      <tr>
                        <td><span class="badge bg-info bg-opacity-10 text-info px-2 py-1"><%= msg.room ? msg.room.name : '삭제된 방' %></span></td>
                        <td id="content-<%= msg._id %>" class="fw-medium"><%= msg.content %></td>
                        <td class="small text-muted"><%= msg.createdAt.toLocaleString() %></td>
                        <td class="text-end">
                          <button class="btn btn-sm btn-outline-warning" onclick="editMessage('<%= msg._id %>')"><i class="fa-solid fa-pen"></i></button>
                          <form action="/profile/message/<%= msg._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('삭제하시겠습니까?')"><i class="fa-solid fa-trash"></i></button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Account Settings Tab -->
            <div class="tab-pane fade" id="account-settings" role="tabpanel">
              <div class="row g-4">
                
                <!-- Password Change -->
                <div class="col-md-6">
                  <div class="p-4 border rounded-4 bg-light h-100">
                    <h5 class="fw-bold mb-4"><i class="fa-solid fa-key me-2 text-primary"></i>비밀번호 변경</h5>
                    <form action="/profile/password?_method=PUT" method="POST">
                      <div class="mb-3">
                        <label class="form-label small fw-bold">현재 비밀번호</label>
                        <input type="password" name="oldPassword" class="form-control shadow-sm" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small fw-bold">새 비밀번호</label>
                        <input type="password" name="newPassword" class="form-control shadow-sm" required>
                      </div>
                      <div class="mb-4">
                        <label class="form-label small fw-bold">새 비밀번호 확인</label>
                        <input type="password" name="confirmPassword" class="form-control shadow-sm" required>
                      </div>
                      <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">비밀번호 변경</button>
                    </form>
                  </div>
                </div>

                <!-- Account Info & Deletion -->
                <div class="col-md-6">
                  <div class="p-4 border rounded-4 bg-light h-100">
                    <h5 class="fw-bold mb-4"><i class="fa-solid fa-shield-halved me-2 text-primary"></i>계정 정보</h5>
                    <div class="mb-4">
                      <label class="form-label small fw-bold">아이디 (ID)</label>
                      <input type="text" class="form-control bg-white border-0 shadow-sm" value="<%= userInfo.username %>" disabled>
                      <small class="text-muted mt-2 d-block">* 아이디는 시스템 무결성을 위해 변경할 수 없습니다.</small>
                    </div>
                    
                    <hr class="my-4">
                    
                    <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>위험 구역</h5>
                    <p class="small text-muted mb-4">계정을 삭제하면 모든 채팅 내역과 알림 정보가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다.</p>
                    <form action="/profile?_method=DELETE" method="POST" onsubmit="return confirm('정말로 계정을 영구 삭제하시겠습니까? 모든 데이터가 사라집니다.')">
                      <button type="submit" class="btn btn-outline-danger w-100 fw-bold">계정 탈퇴</button>
                    </form>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<form id="update-form" method="POST" style="display:none;">
  <input type="hidden" name="content" id="update-content">
</form>

<script>
  function editMessage(id) {
    const currentContent = document.getElementById(`content-${id}`).innerText.trim();
    const newContent = prompt("메시지 수정:", currentContent);
    if (newContent !== null && newContent.trim() !== "" && newContent.trim() !== currentContent) {
      const form = document.getElementById('update-form');
      form.action = `/profile/message/${id}?_method=PUT`;
      document.getElementById('update-content').value = newContent.trim();
      form.submit();
    }
  }
</script>

<%- include('./include/_footer') %>
